# =============================================================================
# Digital Dukan - Git Ignore Rules
# Strictly excludes virtual environments, bytecode, and sensitive credentials
# =============================================================================

# Sensitive Environment Variables & Credentials
.env
.env.*
!.env.example

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files & Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# C extensions & builds
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller / Distribution
*.manifest
*.spec

# Logs and databases
*.db
*.sqlite3
*.log
pip-log.txt
pip-delete-this-directory.txt

# Testing & Coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Flask & Web
instance/
.webassets-cache

# Jupyter / IPython
.ipynb_checkpoints
profile_default/
ipython_config.py

# Editor and IDE configurations
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.db